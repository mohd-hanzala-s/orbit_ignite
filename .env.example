# Orbit Ignite — optional configuration. Copy to .env (loaded automatically by `npm start` / `npm run dev`).

# HTTP port for the API + production web app
PORT=4000

# Where the SQLite database, uploads and extracted SCORM packages live (default: ./data)
# DATA_DIR=./data

# Set to 1 when serving over HTTPS so the session cookie is marked Secure
# COOKIE_SECURE=1

# Maximum upload size in MB (default 1024)
# MAX_UPLOAD_MB=1024

# First run only. By default an empty database is filled with demo data (demo accounts use a public password!).
# For a real deployment set SEED_DEMO=0 to create just one administrator instead:
# SEED_DEMO=0
# ADMIN_EMAIL=you@company.com
# ADMIN_PASSWORD=choose-a-strong-password
